{
  "name": "@axispoint/submission-client",
  "version": "1.0.0",
  "type": "module",
  "description": "The single frontend transport boundary for AxisPoint V2 submissions. No UI, no styling, no network unless explicitly configured.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/wire.ts",
    "./errors": "./src/errors.ts",
    "./transport": "./src/transport.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.3.3"
  }
}
