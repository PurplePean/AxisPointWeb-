{
  "name": "axispoint-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AxisPoint Partners website monorepo",
  "scripts": {
    "dev": "pnpm --filter \"./apps/**\" dev",
    "dev:web": "pnpm --filter @axispoint/web dev",
    "dev:qr": "pnpm --filter @axispoint/qr dev",
    "dev:e2e": "pnpm --filter \"./apps/**\" dev:e2e",
    "dev:e2e:web": "pnpm --filter @axispoint/web dev:e2e",
    "dev:e2e:qr": "pnpm --filter @axispoint/qr dev:e2e",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @axispoint/web build",
    "build:qr": "pnpm --filter @axispoint/qr build",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:gas": "node --test \"scripts/gas/tests/**/*.test.js\"",
    "test:gas-v2": "node --test \"scripts/gas-v2/tests/**/*.test.js\"",
    "gas:push": "cd scripts/gas && clasp push"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
