# Allowlist, not a blocklist: clasp pushes every .js/.gs it finds under this
# directory (skipSubdirectories is false), so anything Node-only that lands here
# later is excluded by default rather than by someone remembering to add it.
#
# This matters because Apps Script runs every pushed file's top-level statements
# in one shared global scope on every invocation. scripts/gas/tests/** is a Node
# test suite that calls require('node:test') at top level; pushing it would throw
# ReferenceError: require is not defined on every doPost and every trigger.

**/**

!appsscript.json
!Code.gs
!emails/**
