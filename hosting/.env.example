# hosting credentials — copy this file to `.env` and fill in real values.
# The real `.env` is gitignored and must NEVER be committed.

# --- cPanel (UAPI + API 2) ---
# CPANEL_HOST: the cPanel hostname WITHOUT scheme or port (scripts add :2083).
#   e.g. server123.web-hosting.com  (your Namecheap/cPanel server hostname)
CPANEL_HOST=
# CPANEL_USERNAME: your cPanel account username.
CPANEL_USERNAME=
# CPANEL_API_TOKEN: create at cPanel > Security > "Manage API Tokens".
#   Give it only the privileges these scripts need.
CPANEL_API_TOKEN=

# --- Namecheap XML API ---
# Enable API access at Namecheap > Profile > Tools > "Namecheap API Access",
# and whitelist NAMECHEAP_CLIENT_IP there.
# NAMECHEAP_API_USER: your Namecheap account username.
NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY: the API key shown on the API Access page.
NAMECHEAP_API_KEY=
# NAMECHEAP_CLIENT_IP: the public IP you'll call the API from (must be
#   whitelisted in the Namecheap dashboard). Find it with: curl ifconfig.me
NAMECHEAP_CLIENT_IP=
# NAMECHEAP_USERNAME (optional): defaults to NAMECHEAP_API_USER if unset.
# NAMECHEAP_USERNAME=
