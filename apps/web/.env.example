# V2 submission endpoint for @axispoint/web.
#
# Deliberately NOT named VITE_FORM_ENDPOINT: that name refers to the V1 Apps Script
# deployment, which speaks a different payload shape. The V2 intake reads only the name
# below, and vite.config.ts treats a lone V1 value as an error rather than a default.
#
# Plain `pnpm dev` ignores this entirely and always runs the simulator.
VITE_V2_SUBMISSION_ENDPOINT=your_v2_apps_script_url_here
