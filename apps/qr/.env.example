# V2 submission endpoint for @axispoint/qr.
#
# Changed in Code Pass 10B. NOT named VITE_FORM_ENDPOINT: that name refers to the V1 Apps
# Script deployment, which speaks a different payload shape. The QR Contact Exchange submits
# a V2 contact_exchange envelope, so it reads only the name below, and vite.endpoint.ts
# treats a lone V1 value as an error rather than a default.
#
# Plain `pnpm dev` ignores this entirely and always runs the simulator.
VITE_V2_SUBMISSION_ENDPOINT=your_v2_apps_script_url_here
